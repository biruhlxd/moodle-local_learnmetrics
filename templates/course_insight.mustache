{{!
    @template local_learnmetrics/course_insight

    Course insight: the completion funnel of a course and the activities nobody opened in the period.

    Example context (json):
    {
        "formurl": "#",
        "courseid": 2,
        "periods": [{"value": 30, "name": "Last 30 days", "selected": true}],
        "groupsonly": false,
        "completionenabled": true,
        "haslearners": true,
        "learnercount": 20,
        "hassteps": true,
        "steps": [{"name": "Welcome", "url": "#", "completed": 18, "percent": 90, "drop": 2, "biggest": false},
            {"name": "Module 1 quiz", "url": "#", "completed": 9, "percent": 45, "drop": 9, "biggest": true}],
        "hasquiet": true,
        "quiet": [{"name": "Further reading", "url": "#", "iconurl": "#", "modfullname": "Page"}],
        "days": 30,
        "sections": [],
        "backurl": "#"
    }
}}
<div class="local-learnmetrics">
    <form method="get" action="{{formurl}}" class="d-flex flex-wrap align-items-end gap-3 mb-4">
        <input type="hidden" name="id" value="{{courseid}}">
        <div>
            <label for="local-learnmetrics-days" class="form-label">{{#str}} period, local_learnmetrics {{/str}}</label>
            <select id="local-learnmetrics-days" name="days" class="form-select">
                {{#periods}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{name}}</option>{{/periods}}
            </select>
        </div>
        <button type="submit" class="btn btn-primary">{{#str}} apply, local_learnmetrics {{/str}}</button>
    </form>
    {{#groupsonly}}
    <div class="alert alert-info" role="status">{{#str}} yourgroupsonly, local_learnmetrics {{/str}}</div>
    {{/groupsonly}}

    <h3 class="h4">{{#str}} funnel, local_learnmetrics {{/str}}</h3>
    <p class="text-muted">{{#str}} funnel_desc, local_learnmetrics {{/str}}</p>
    {{^completionenabled}}
    <div class="alert alert-info">{{#str}} completionnotenabled, local_learnmetrics {{/str}}</div>
    {{/completionenabled}}
    {{#completionenabled}}
    {{^hassteps}}
    <div class="alert alert-info">{{#str}} nocompletionactivities, local_learnmetrics {{/str}}</div>
    {{/hassteps}}
    {{/completionenabled}}
    {{#hassteps}}
    {{^haslearners}}
    <div class="alert alert-info">{{#str}} nolearners, local_learnmetrics {{/str}}</div>
    {{/haslearners}}
    {{#haslearners}}
    <p>{{#str}} learnercount, local_learnmetrics, {{learnercount}} {{/str}}</p>
    <div class="table-responsive mb-4">
        <table class="table local-learnmetrics-funnel">
            <caption class="visually-hidden">{{#str}} funnel, local_learnmetrics {{/str}}</caption>
            <thead>
                <tr>
                    <th scope="col">{{#str}} activity {{/str}}</th>
                    <th scope="col" class="text-end">{{#str}} completed, local_learnmetrics {{/str}}</th>
                    <th scope="col">{{#str}} funnel_share, local_learnmetrics {{/str}}</th>
                    <th scope="col" class="text-end">{{#str}} funnel_drop, local_learnmetrics {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#steps}}
                <tr>
                    <th scope="row" class="fw-normal">
                        {{#url}}<a href="{{url}}">{{name}}</a>{{/url}}{{^url}}{{name}}{{/url}}
                        {{#biggest}}<span class="badge text-bg-warning ms-1">{{#str}} funnel_biggest, local_learnmetrics {{/str}}</span>{{/biggest}}
                    </th>
                    <td class="text-end">{{completed}}</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress flex-grow-1" aria-hidden="true">
                                <div class="progress-bar" style="width: {{percent}}%"></div>
                            </div>
                            <span class="local-learnmetrics-funnel-percent text-end">{{percent}}%</span>
                        </div>
                    </td>
                    <td class="text-end">{{#drop}}−{{drop}}{{/drop}}{{^drop}}<span class="text-muted">0</span>{{/drop}}</td>
                </tr>
                {{/steps}}
            </tbody>
        </table>
    </div>
    {{/haslearners}}
    {{/hassteps}}

    <h3 class="h4">{{#str}} quietactivities, local_learnmetrics {{/str}}</h3>
    <p class="text-muted">{{#str}} quietactivities_desc, local_learnmetrics, {{days}} {{/str}}</p>
    {{^hasquiet}}
    <div class="alert alert-success">{{#str}} quietactivities_none, local_learnmetrics {{/str}}</div>
    {{/hasquiet}}
    {{#hasquiet}}
    <ul class="list-unstyled mb-4">
        {{#quiet}}
        <li class="mb-1">
            <img src="{{iconurl}}" alt="" class="icon">
            <a href="{{url}}">{{name}}</a> <span class="text-muted small">{{modfullname}}</span>
        </li>
        {{/quiet}}
    </ul>
    {{/hasquiet}}

    {{#sections}}{{{.}}}{{/sections}}

    <p><a href="{{backurl}}">{{#str}} backtodashboard, local_learnmetrics {{/str}}</a></p>
</div>
