{{!
    @template local_learnmetrics/my_progress

    The progress of a learner: learning time and courses, and the sections of other plugins.

    Example context (json):
    {
        "formurl": "#",
        "userid": 5,
        "periods": [{"value": 30, "name": "Last 30 days", "selected": true}],
        "cards": [{"label": "Learning hours", "value": "3.5"}, {"label": "Courses completed", "value": "1 of 3"}],
        "chart": "",
        "hascourses": true,
        "courses": [{"fullname": "Safety training", "url": "#", "hasprogress": true, "progress": 60, "completed": null,
            "timespent": "2 hours 5 mins", "lastactivity": "27/10/26"}],
        "sections": []
    }
}}
<div class="local-learnmetrics">
    <form method="get" action="{{formurl}}" class="d-flex flex-wrap align-items-end gap-3 mb-4">
        {{#userid}}<input type="hidden" name="userid" value="{{userid}}">{{/userid}}
        <div>
            <label for="local-learnmetrics-days" class="form-label">{{#str}} period, local_learnmetrics {{/str}}</label>
            <select id="local-learnmetrics-days" name="days" class="form-select">
                {{#periods}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{name}}</option>{{/periods}}
            </select>
        </div>
        <button type="submit" class="btn btn-primary">{{#str}} apply, local_learnmetrics {{/str}}</button>
    </form>

    <div class="row g-3 mb-4">
        {{#cards}}
        <div class="col-6 col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="small text-muted">{{label}}</div>
                    <div class="fs-3 fw-bold">{{value}}</div>
                </div>
            </div>
        </div>
        {{/cards}}
    </div>

    {{#chart}}
    <div class="card mb-4"><div class="card-body">{{{chart}}}</div></div>
    {{/chart}}

    {{#sections}}{{{.}}}{{/sections}}

    <h3 class="h4">{{#str}} mycourses, local_learnmetrics {{/str}}</h3>
    {{#hascourses}}
    <div class="table-responsive mb-4">
        <table class="table table-striped">
            <caption class="visually-hidden">{{#str}} mycourses, local_learnmetrics {{/str}}</caption>
            <thead>
                <tr>
                    <th scope="col">{{#str}} course {{/str}}</th>
                    <th scope="col">{{#str}} progress, local_learnmetrics {{/str}}</th>
                    <th scope="col">{{#str}} timespent, local_learnmetrics {{/str}}</th>
                    <th scope="col">{{#str}} lastactivity, local_learnmetrics {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#courses}}
                <tr>
                    <td><a href="{{url}}">{{fullname}}</a></td>
                    <td>
                        {{#completed}}
                        <span class="badge bg-success">{{#str}} completedon, local_learnmetrics, {{completed}} {{/str}}</span>
                        {{/completed}}
                        {{^completed}}
                        {{#hasprogress}}
                        <div class="progress" role="progressbar" aria-valuenow="{{progress}}" aria-valuemin="0" aria-valuemax="100"
                            aria-label="{{#str}} progress, local_learnmetrics {{/str}}">
                            <div class="progress-bar" style="width: {{progress}}%">{{progress}}%</div>
                        </div>
                        {{/hasprogress}}
                        {{^hasprogress}}-{{/hasprogress}}
                        {{/completed}}
                    </td>
                    <td>{{timespent}}</td>
                    <td>{{lastactivity}}</td>
                </tr>
                {{/courses}}
            </tbody>
        </table>
    </div>
    {{/hascourses}}
    {{^hascourses}}
    <div class="alert alert-info">{{#str}} nocourses, local_learnmetrics {{/str}}</div>
    {{/hascourses}}
</div>
