{{!
    @template local_learnmetrics/about

    About LearnMetrics: release, maintainer, documentation and support.

    Example context (json):
    {
        "details": "Installed release: 1.2.0 · Supported Moodle: 5.0–5.3 · GNU GPL v3 or later",
        "maintainer": [{"url": "https://biruh.org/", "name": "Biruh Alemnew, website"}],
        "support": [{"url": "#", "name": "Documentation"}, {"url": "#", "name": "Report an issue or request a feature"}]
    }
}}
<h3>{{#str}} about_heading, local_learnmetrics {{/str}}</h3>
<p>{{#str}} about_intro, local_learnmetrics {{/str}}</p>
<p>{{details}}</p>

<h3>{{#str}} about_maintainer, local_learnmetrics {{/str}}</h3>
<ul>
    {{#maintainer}}
    <li><a href="{{url}}" target="_blank" rel="noopener">{{name}}</a></li>
    {{/maintainer}}
</ul>

<h3>{{#str}} about_support, local_learnmetrics {{/str}}</h3>
<ul>
    {{#support}}
    <li><a href="{{url}}" target="_blank" rel="noopener">{{name}}</a></li>
    {{/support}}
</ul>
